.DS_Store
.idea
.ipynb_checkpoints/
.vscode
__pycache__/
*.pyc
*.pt

# 数据文件不提交（按需通过 data/*/download_*.py 下载、prepare.py 生成）
data/*/*.txt
data/*/tokenizer.json
data/*/train.bin
data/*/val.bin
data/*/meta.pkl
data/*/manifest.json
# 数据备份/中间产物（如 train.bin.bak-*）
data/*/*.bak*
*.bak*

# Rust 推理框架转换产物（由 inference/runtime/scripts/convert.py 重新生成）
inference/runtime/target/
inference/runtime/model.safetensors
inference/runtime/model_config.json
inference/runtime/vocab.json
inference/runtime/tokenizer.json
inference/runtime/Cargo.lock

# 训练 checkpoint 输出目录
out/

# 打包产物（由 inference/scripts/package.py 生成）
release/

# 依赖锁文件（按需重新生成）
uv.lock
