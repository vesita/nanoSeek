.DS_Store
.idea
.ipynb_checkpoints/
.vscode
__pycache__/
*.pyc
*.pt

# 数据文件不提交（按需通过 data/*/download_*.py 下载、prepare.py 生成）
data/*/*.txt
data/*/tokenizer.json
data/*/*.bin
*.bin
data/*/meta.pkl
data/*/manifest.json
# 字级/字节直入数据产物（dev-notes/48/50，train_tokenizer.py/prepare.py 可重建）
data/*/train_byte.bin
data/*/val_byte.bin
data/*/train_char.bin
data/*/val_char.bin
data/*/meta_byte.pkl
data/*/meta_char.pkl
data/*/char_tokenizer.json
# 数据备份/中间产物（如 train.bin.bak-*）
data/*/*.bak*
*.bak*
# 数据治理快照（govern_dialogue_data.py 产出：治理前备份 + 被剔除源，本地可回滚、不进库）
data/*/_backup_*/
data/*/_discarded/

# 外部克隆的开源数据仓库（TheAlgorithms/doocs/chinese-poetry，第三方代码不进库）
data/external/
# 纯文本预训练语料（parse_external_pretrain.py 从外部仓库生成，可重建）
data/chinese/pretrain/
data/paper/

# Rust 推理框架转换产物（由 inference/runtime/scripts/convert.py 重新生成）
inference/runtime/target/
inference/runtime/model.safetensors
inference/runtime/model_config.json
inference/runtime/vocab.json
inference/runtime/tokenizer.json
inference/runtime/Cargo.lock

# 训练 checkpoint 输出目录
out/

# 打包产物（由 inference/scripts/package.py 生成）
release/

# 依赖锁文件（按需重新生成）
uv.lock

# 本地优化杂物间（本机专属，不进 git）
local/
temp/

# 数据下载日志 / 临时产物（可按需重新下载生成）
data/*/*.log
data/*/*.tmp
